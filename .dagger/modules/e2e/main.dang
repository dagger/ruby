"""
End-to-end checks for the Ruby module family.
"""
type E2e {
  let assert(ok: Boolean!, message: String!): Void {
    if (ok == false) { raise message }
    null
  }

  # A check called through a dependency comes back as a Check that has not run.
  let failureOf(check: Check!): String! {
    if (check.pass) { "passed" } else { check.error.message ?? "check failed" }
  }

  let errorOf(env: Ruby!, ws: Workspace!): String! {
    { env.container(ws).sync; "passed" } rescue {
      err: Error => err.message
    }
  }

  let testdata(ws: Workspace!): Directory! {
    ws.directory("/rubocop/testdata")
  }

  # The official image redirects BUNDLE_APP_CONFIG; without it, Bundler reads
  # a project's .bundle/config.
  let customBase: Container! {
    container
      .from("ruby:4.0@sha256:342dd3092e25f9d16fc2a5c48c5bb2d9a93717d4f900d005d6e088e2c45d3d19")
      .withoutEnvVariable("BUNDLE_APP_CONFIG")
      .withNewFile("/custom-base", "custom")
  }

  """
  The shared environment validates roots, honours a custom base, keeps test gems
  a project .bundle/config excludes, and explains a missing lockfile.
  """
  rubyEnvCheck(ws: Workspace!): Void @check {
    let source = ws.directory("/minitest/testdata")
    let escaped = errorOf(ruby(root: "../project"), source.asWorkspace)
    assert(escaped.contains("workspace-relative"), "accepted a root outside the workspace: " + escaped)
    let absolute = errorOf(ruby(root: "/project"), source.asWorkspace)
    assert(absolute.contains("workspace-relative"), "accepted an absolute root: " + absolute)
    let missing = errorOf(ruby, source.asWorkspace)
    assert(missing.contains("no Gemfile in ."), "missing Gemfile was not explained: " + missing)
    let env = ruby(root: "./project/", base: customBase)
    let unlocked = errorOf(env, source.withoutFile("project/Gemfile.lock").asWorkspace)
    assert(unlocked.contains("no Gemfile.lock in project"), "missing lockfile was not explained: " + unlocked)
    let ctr = env.container(source.withNewFile("project/.bundle/config", "---\nBUNDLE_WITHOUT: \"test\"\n").asWorkspace)
    assert(ctr.file("/custom-base").contents == "custom", "custom base was not used")
    ctr.withExec(["bundle", "exec", "rake", "--version"]).sync
    null
  }

  """
  A passing suite passes; a failing test fails with Minitest's output.
  """
  minitestCheck(ws: Workspace!): Void @check {
    let source = ws.directory("/minitest/testdata")
    let tool = minitest(root: "project")
    let result = failureOf(tool.test(source.asWorkspace))
    assert(result == "passed", "passing suite failed: " + result)
    let broken = source.withNewFile(
      "project/test/broken_test.rb",
      "require \"minitest/autorun\"\n\nclass BrokenTest < Minitest::Test\n  def test_broken\n    flunk \"minitest failure sentinel\"\n  end\nend\n",
    )
    let failed = failureOf(tool.test(broken.asWorkspace))
    assert(failed.contains("minitest failure sentinel"), "failing test did not fail with its output: " + failed)
    null
  }

  """
  A clean locked project passes with its own .rubocop.yml and a path gem's
  inherited style.
  """
  lintPassCheck(ws: Workspace!): Void @check {
    let source = testdata(ws).asWorkspace
    let result = failureOf(rubocop(root: "project").lint(source))
    assert(result == "passed", "clean project failed: " + result)
    let cops = ruby(root: "project")
      .container(source)
      .withExec(["bundle", "exec", "rubocop", "--show-cops", "Style/StringLiterals,Style/FrozenStringLiteralComment"])
      .stdout
    assert(cops.contains("EnforcedStyle: double_quotes"), "path gem configuration was not inherited: " + cops)
    assert(cops.contains("Enabled: false"), "project .rubocop.yml was not used: " + cops)
    null
  }

  """
  Offenses fail with RuboCop's output.
  """
  lintFailureCheck(ws: Workspace!): Void @check {
    let source = testdata(ws).withNewFile("project/lib/bad.rb", "# Bad.\nmodule Bad\n  NAME = 'single'\nend\n")
    let offense = failureOf(rubocop(root: "project").lint(source.asWorkspace))
    assert(offense.contains("Style/StringLiterals"), "offense did not fail with RuboCop output: " + offense)
    null
  }
}
