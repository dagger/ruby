"""
End-to-end checks for the Ruby module family.
"""
type E2e {
  let assert(ok: Boolean!, message: String!): Void {
    if (ok == false) { raise message }
    null
  }

  # A check called through a dependency comes back as a Check that has not run.
  let failureOf(check: Check!): String! {
    if (check.pass) { "passed" } else { check.error.message ?? "check failed" }
  }

  let minitestBroken: String! = "require \"minitest/autorun\"\n\nclass BrokenTest < Minitest::Test\n  def test_broken\n    flunk \"minitest failure sentinel\"\n  end\nend\n"
  let rspecBroken: String! = "RSpec.describe \"broken\" do\n  it \"fails\" do\n    expect(1).to eq(2), \"rspec failure sentinel\"\n  end\nend\n"

  # The test tools raise with their output when a run fails.
  let outcome(&run(): Void): String! {
    { run(); "passed" } rescue {
      err: Error => err.message
    }
  }

  let errorOf(env: Ruby!, ws: Workspace!): String! {
    { env.container(ws).sync; "passed" } rescue {
      err: Error => err.message
    }
  }

  let testdata(ws: Workspace!): Directory! {
    ws.directory("/rubocop/testdata")
  }

  # The official image redirects BUNDLE_APP_CONFIG; without it, Bundler reads
  # a project's .bundle/config.
  let customBase: Container! {
    container
      .from("ruby:4.0@sha256:342dd3092e25f9d16fc2a5c48c5bb2d9a93717d4f900d005d6e088e2c45d3d19")
      .withoutEnvVariable("BUNDLE_APP_CONFIG")
      .withNewFile("/custom-base", "custom")
  }

  """
  The shared environment validates roots, honours a custom base, keeps test gems
  a project .bundle/config excludes, and explains a missing lockfile.
  """
  rubyEnvCheck(ws: Workspace!): Void @check {
    let source = ws.directory("/minitest/testdata")
    let escaped = errorOf(ruby(root: "../project"), source.asWorkspace)
    assert(escaped.contains("workspace-relative"), "accepted a root outside the workspace: " + escaped)
    let absolute = errorOf(ruby(root: "/project"), source.asWorkspace)
    assert(absolute.contains("workspace-relative"), "accepted an absolute root: " + absolute)
    let missing = errorOf(ruby, source.asWorkspace)
    assert(missing.contains("no Gemfile in ."), "missing Gemfile was not explained: " + missing)
    let env = ruby(root: "./project/", base: customBase)
    let unlocked = errorOf(env, source.withoutFile("project/Gemfile.lock").asWorkspace)
    assert(unlocked.contains("no Gemfile.lock in project"), "missing lockfile was not explained: " + unlocked)
    let ctr = env.container(source.withNewFile("project/.bundle/config", "---\nBUNDLE_WITHOUT: \"test\"\n").asWorkspace)
    assert(ctr.file("/custom-base").contents == "custom", "custom base was not used")
    ctr.withExec(["bundle", "exec", "rake", "--version"]).sync
    null
  }

  """
  A passing suite passes; a failing test fails with Minitest's output.
  """
  minitestCheck(ws: Workspace!): Void @check {
    let source = ws.directory("/minitest/testdata")
    let tool = minitest(root: "project")
    let result = outcome { tool.test(source.asWorkspace) }
    assert(result == "passed", "passing suite failed: " + result)
    let broken = source.withNewFile("project/test/broken_test.rb", minitestBroken)
    # Untraced, so this expected failure stays out of Dagger's test summary.
    let failed = outcome { minitest(root: "project", tracing: false).test(broken.asWorkspace) }
    assert(failed.contains("minitest failure sentinel"), "failing test did not fail with its output: " + failed)
    null
  }

  """
  A passing suite passes; a failing spec fails with RSpec's output.
  """
  rspecCheck(ws: Workspace!): Void @check {
    let source = ws.directory("/rspec/testdata")
    let tool = rspec(root: "project")
    let result = outcome { tool.test(source.asWorkspace) }
    assert(result == "passed", "passing suite failed: " + result)
    let broken = source.withNewFile("project/spec/broken_spec.rb", rspecBroken)
    # Untraced, so this expected failure stays out of Dagger's test summary.
    let failed = outcome { rspec(root: "project", tracing: false).test(broken.asWorkspace) }
    assert(failed.contains("rspec failure sentinel"), "failing spec did not fail with its output: " + failed)
    null
  }

  """
  A Rails app's tests pass on its SQLite test database; a failing test fails
  with Rails' output.
  """
  railsSqliteCheck(ws: Workspace!): Void @check {
    let source = ws.directory("/rails/testdata")
    let tool = rails(root: "project")
    let result = outcome { tool.test(source.asWorkspace) }
    assert(result == "passed", "passing app failed: " + result)
    let broken = source.withNewFile(
      "project/test/models/broken_test.rb",
      "require \"test_helper\"\n\nclass BrokenTest < ActiveSupport::TestCase\n  test \"fails\" do\n    flunk \"rails failure sentinel\"\n  end\nend\n",
    )
    # Untraced, so this expected failure stays out of Dagger's test summary.
    let failed = outcome { rails(root: "project", tracing: false).test(broken.asWorkspace) }
    assert(failed.contains("rails failure sentinel"), "failing test did not fail with its output: " + failed)
    null
  }

  """
  The Rails service answers its health endpoint.
  """
  railsServerCheck(ws: Workspace!): Void @check {
    customBase
      .withServiceBinding("rails", rails(root: "project").server(ws.directory("/rails/testdata").asWorkspace))
      .withExec(["curl", "-fsS", "-H", "Host: localhost", "http://rails:3000/up"])
      .sync
    null
  }

  """
  Asset precompilation returns digested files.
  """
  railsAssetsCheck(ws: Workspace!): Void @check {
    let source = ws.directory("/rails/testdata")
    let compiled = rails(root: "project").assets(source.asWorkspace)
    assert(compiled.glob("application-*.css").length == 1, "no digested stylesheet: " + compiled.glob("*").join(", "))
    null
  }

  """
  The formatter fixes only layout, in only the badly laid-out file, and is
  idempotent. Trailing spaces in a multiline string literal are removed, as
  documented; a heredoc keeps them.
  """
  rubocopFormatCheck(ws: Workspace!): Void @check {
    let source = testdata(ws).withNewFile(
      "project/lib/messy.rb",
      "# Messy.\nmodule Messy\n    VALUE = 'one'   \n  TEXT = <<~DOC\n    kept  \n  DOC\n  MULTI = \"a  \nb\"\nend\n",
    )
    let tool = rubocop(root: "project")
    let changes = tool.format(source.asWorkspace)
    assert(changes.modifiedPaths == ["project/lib/messy.rb"], "formatter modified other files: " + changes.modifiedPaths.join(", "))
    assert(changes.addedPaths.isEmpty and changes.removedPaths.isEmpty, "formatter added or removed files")
    let formatted = changes.after.file("project/lib/messy.rb").contents
    let expected = "# Messy.\nmodule Messy\n  VALUE = 'one'\n  TEXT = <<~DOC\n    kept#{'  '}\n  DOC\n  MULTI = \"a\nb\"\nend\n"
    assert(formatted == expected, "unexpected layout: " + formatted)
    let reformatted = tool.format(source.withDirectory("project", changes.after.directory("project")).asWorkspace)
    assert(reformatted.isEmpty, "formatter is not idempotent")
    null
  }

  """
  A lockfile with no gems passes, so it can never become vulnerable. The
  fixture pins rack 2.0.1 to fail on CVE-2018-16471, fixed in 2018 and not
  expected to be withdrawn; that lockfile triggers Dependabot alerts by design.
  """
  bundlerAuditCheck(ws: Workspace!): Void @check {
    let tool = bundlerAudit(root: "project")
    let empty = directory
      .withNewFile("project/Gemfile", "source \"https://rubygems.org\"\n")
      .withNewFile(
        "project/Gemfile.lock",
        "GEM\n  remote: https://rubygems.org/\n  specs:\n\nPLATFORMS\n  ruby\n  x86_64-linux\n\nDEPENDENCIES\n\nCHECKSUMS\n  bundler (4.0.24) sha256=16ca64e20816a0cf151a948fb141d788602996d2b4d73577b74388fe84fa98bc\n\nBUNDLED WITH\n  4.0.24\n",
      )
    let clean = failureOf(tool.audit(empty.asWorkspace))
    assert(clean == "passed", "clean lockfile failed: " + clean)
    let vulnerable = failureOf(tool.audit(ws.directory("/bundler-audit/testdata").asWorkspace))
    assert(vulnerable.contains("CVE-2018-16471"), "vulnerable lockfile did not report its advisory: " + vulnerable)
    null
  }

  """
  Updating rack moves it off 2.0.1 within 2.x, changing only Gemfile.lock,
  even when Git ignores it, and updating again changes nothing. An unknown gem
  fails with its name, an option is not taken as a gem, and a project without
  Gemfile.lock gets one. The fixture pins rack 2.0.1 on purpose so a newer 2.x
  always exists; that lockfile triggers Dependabot alerts by design.
  """
  bundleUpdateCheck(ws: Workspace!): Void @check {
    let source = ws.directory("/bundle/testdata")
    let tool = bundle(root: "project")
    let changes = tool.update(source.asWorkspace, gems: ["rack"])
    assert(changes.modifiedPaths == ["project/Gemfile.lock"], "update modified other files: " + changes.modifiedPaths.join(", "))
    assert(changes.addedPaths.isEmpty and changes.removedPaths.isEmpty, "update added or removed files")
    let updated = changes.after.file("project/Gemfile.lock")
    let lock = updated.contents
    assert(lock.contains("rack (2.0.1)") == false and lock.contains("rack (2."), "rack did not move within 2.x: " + lock)
    let again = tool.update(source.withFile("project/Gemfile.lock", updated).asWorkspace, gems: ["rack"])
    assert(again.isEmpty, "a second update changed Gemfile.lock")
    let unknown = outcome { tool.update(source.asWorkspace, gems: ["no-such-gem"]).isEmpty; null }
    assert(unknown.contains("no-such-gem"), "an unknown gem did not fail with its name: " + unknown)
    let option = outcome { tool.update(source.asWorkspace, gems: ["--print"]).isEmpty; null }
    assert(option.contains("not a gem name: --print"), "an option was taken as a gem: " + option)
    let ignored = tool.update(source.withNewFile("project/.gitignore", "Gemfile.lock\n").asWorkspace, gems: ["rack"])
    assert(ignored.modifiedPaths == ["project/Gemfile.lock"], "an ignored lockfile was not updated: " + ignored.addedPaths.join(", "))
    let created = tool.update(source.withoutFile("project/Gemfile.lock").asWorkspace)
    assert(created.addedPaths == ["project/Gemfile.lock"], "a missing lockfile was not added: " + created.addedPaths.join(", "))
    null
  }

  """
  The Rails fixture scans clean; a controller evaluating a parameter fails
  with Brakeman's Dangerous Eval warning, which the app's config/brakeman.yml
  can skip.
  """
  brakemanCheck(ws: Workspace!): Void @check {
    let source = ws.directory("/rails/testdata")
    let tool = brakeman(root: "project")
    let clean = failureOf(tool.scan(source.asWorkspace))
    assert(clean == "passed", "clean app failed: " + clean)
    let evil = source.withNewFile(
      "project/app/controllers/evil_controller.rb",
      "class EvilController < ActionController::Base\n  def run\n    eval(params[:code])\n  end\nend\n",
    )
    let failed = failureOf(tool.scan(evil.asWorkspace))
    assert(failed.contains("Dangerous Eval"), "eval of a parameter was not reported: " + failed)
    let configured = failureOf(
      tool.scan(evil.withNewFile("project/config/brakeman.yml", "---\n:skip_checks:\n- CheckEvaluation\n").asWorkspace),
    )
    assert(
      configured.contains("Cross-Site Request Forgery") and configured.contains("Dangerous Eval") == false,
      "config/brakeman.yml was not applied: " + configured,
    )
    null
  }

  """
  A typed project passes; a call with the wrong arity fails with Sorbet's error.
  """
  typecheckCheck(ws: Workspace!): Void @check {
    let source = ws.directory("/sorbet/testdata")
    let tool = sorbet(root: "project")
    let result = failureOf(tool.typecheck(source.asWorkspace))
    assert(result == "passed", "typed project failed: " + result)
    let broken = source.withNewFile("project/lib/broken.rb", "# typed: true\nGreeting.hello(1, 2)\n")
    let failed = failureOf(tool.typecheck(broken.asWorkspace))
    assert(failed.contains("Too many arguments provided"), "type error was not reported: " + failed)
    null
  }

  """
  Documented code passes and builds; an @param naming no argument fails with
  YARD's warning, even when the project's .yardopts asks for --quiet.
  """
  docsCheck(ws: Workspace!): Void @check {
    let source = ws.directory("/yard/testdata")
    let tool = yard(root: "project")
    let result = failureOf(tool.docs(source.asWorkspace))
    assert(result == "passed", "documented project failed: " + result)
    assert(tool.build(source.asWorkspace).glob("Greeting.html").length == 1, "build did not document Greeting")
    let broken = source.withNewFile(
      "project/lib/broken.rb",
      "# Broken docs.\nmodule Broken\n  # @param missing [String] not an argument\n  def self.run(value) = value\nend\n",
    )
    let failed = failureOf(tool.docs(broken.asWorkspace))
    assert(failed.contains("unknown parameter name: missing"), "YARD warning was not reported: " + failed)
    let quiet = failureOf(tool.docs(broken.withNewFile("project/.yardopts", "--quiet\n").asWorkspace))
    assert(quiet.contains("unknown parameter name: missing"), "a quiet .yardopts hid the warning: " + quiet)
    null
  }

  """
  The gemspec builds greeter-0.1.0.gem with its lib files; a gemspec listing
  a missing file, or no files, fails with an actionable error.
  """
  gemBuildCheck(ws: Workspace!): Void @check {
    let source = ws.directory("/gem/testdata")
    let tool = gem(root: "project")
    let built = tool.build(source.asWorkspace)
    assert(built.name == "greeter-0.1.0.gem", "unexpected gem file: " + built.name)
    let files = customBase.withFile("/greeter.gem", built).withExec(["gem", "spec", "/greeter.gem", "files"]).stdout
    assert(files.contains("lib/greeter.rb"), "gem lacks its lib file: " + files)
    let gemspec = source.file("project/greeter.gemspec").contents.replace(
      old: "Dir[\"lib/**/*.rb\"]",
      new: "[\"lib/greeter.rb\", \"lib/missing.rb\"]",
    )
    let missing = failureOf(tool.gemspec(source.withNewFile("project/greeter.gemspec", gemspec).asWorkspace))
    assert(missing.contains("[\"lib/missing.rb\"] are not files"), "missing file was not reported: " + missing)
    let none = source.file("project/greeter.gemspec").contents.replace(old: "Dir[\"lib/**/*.rb\"]", new: "[]")
    let empty = failureOf(tool.gemspec(source.withNewFile("project/greeter.gemspec", none).asWorkspace))
    assert(empty.contains("spec.files is empty"), "an empty gem was not rejected: " + empty)
    null
  }

  """
  publish pushes the built gem to a disposable mock server, never
  rubygems.org, which accepts only POST /api/v1/gems with a body and the right
  key; a wrong key or an unreachable host fails without revealing either key.
  """
  gemPublishCheck(ws: Workspace!): Void @check {
    let source = ws.directory("/gem/testdata").asWorkspace
    let tool = gem(root: "project")
    let mock = customBase
      .withFile("/mock.rb", currentModule.source.file("mock-gem-server.rb"))
      .withExposedPort(8080)
      .asService(args: ["ruby", "/mock.rb"])
    mock.start
    let host = mock.endpoint(scheme: "http")
    tool.publish(source, host: host, apiKey: setSecret("gem-publish-api-key", "dummy-key"))
    let wrongKey = setSecret("gem-publish-wrong-key", "wrong-key")
    let rejected = { tool.publish(source, host: host, apiKey: wrongKey); "passed" } rescue {
      err: Error => err.message
    }
    assert(rejected.contains("gem push to " + host + " failed"), "a wrong key was accepted: " + rejected)
    assert(rejected.contains("wrong-key") == false and rejected.contains("dummy-key") == false, "a key leaked into the error")
    let unreachable = { tool.publish(source, host: "http://127.0.0.1:9", apiKey: wrongKey); "passed" } rescue {
      err: Error => err.message
    }
    assert(unreachable.contains("gem push to http://127.0.0.1:9 failed"), "unreachable host was not reported: " + unreachable)
    null
  }

  let countOf(list: [String!]!, line: String!): Int! {
    list.filter { other => other == line }.length
  }

  # Dagger sets the OTLP endpoint for every exec, so a RUBYOPT preload in the
  # base points the plugin elsewhere; the UUID keeps the runs from replaying.
  let redirect(endpoint: String!): Container! {
    customBase
      .withNewFile("/redirect.rb", "# " + UUID.v7 + "\nENV[\"OTEL_EXPORTER_OTLP_TRACES_ENDPOINT\"] = \"" + endpoint + "\"\n")
      .withEnvVariable("RUBYOPT", "-r/redirect.rb")
  }

  # Services with the same definition are one service, so each check names
  # its own receiver.
  let otlpReceiver(name: String!): String! {
    let receiver = customBase
      .withFile("/receiver.rb", currentModule.source.file("mock-otlp-receiver.rb"))
      .withExposedPort(4318)
      .asService(args: ["ruby", "/receiver.rb", name])
    receiver.start
    receiver.endpoint(scheme: "http")
  }

  # Test order within a run is random, so compare counts, not positions.
  let assertSpans(host: String!, expected: [String!]!): Void {
    let spans = customBase.withExec(["curl", "-fsS", host + "/spans?run=" + UUID.v7]).stdout.split("\n")
    assert(
      spans.length == expected.length and expected.all { line => countOf(spans, line) == countOf(expected, line) },
      "receiver did not get exactly the expected spans: " + spans.join(", "),
    )
  }

  """
  With tracing, Minitest sends a session span and a span per test with its
  outcome; a collector that cannot be reached leaves the verdict unchanged.
  """
  minitestOtelCheck(ws: Workspace!): Void @check {
    let source = ws.directory("/minitest/testdata")
    let broken = source.withNewFile("project/test/broken_test.rb", minitestBroken)
    let host = otlpReceiver("minitest-otel")
    let traced = minitest(root: "project", base: redirect(host + "/v1/traces"))
    let passed = outcome { traced.test(source.asWorkspace) }
    assert(passed == "passed", "traced passing suite failed: " + passed)
    let failed = outcome { traced.test(broken.asWorkspace) }
    assert(failed.contains("minitest failure sentinel"), "traced failing suite passed")
    assertSpans(host, [
      "minitest success", "AdderTest#test_add pass",
      "minitest failure", "AdderTest#test_add pass", "BrokenTest#test_broken fail",
    ])
    let unreachable = minitest(root: "project", base: redirect("http://127.0.0.1:9/v1/traces"))
    let unreached = outcome { unreachable.test(source.asWorkspace) }
    assert(unreached == "passed", "an unreachable collector failed the tests: " + unreached)
    null
  }

  """
  With tracing, RSpec sends a session span and a span per example with its
  outcome.
  """
  rspecOtelCheck(ws: Workspace!): Void @check {
    let source = ws.directory("/rspec/testdata")
    let broken = source.withNewFile("project/spec/broken_spec.rb", rspecBroken)
    let host = otlpReceiver("rspec-otel")
    let traced = rspec(root: "project", base: redirect(host + "/v1/traces"))
    let passed = outcome { traced.test(source.asWorkspace) }
    assert(passed == "passed", "traced passing suite failed: " + passed)
    let failed = outcome { traced.test(broken.asWorkspace) }
    assert(failed.contains("rspec failure sentinel"), "traced failing suite passed")
    assertSpans(host, [
      "rspec success", "Adder adds two numbers pass",
      "rspec failure", "Adder adds two numbers pass", "broken fails fail",
    ])
    null
  }

  """
  Test files under test/ named test_*.rb or *_test.rb are the collection's
  keys. Selecting one runs only its tests, selecting none runs nothing, and no
  selection runs every file.
  """
  minitestCollectionCheck(ws: Workspace!): Void @check {
    let source = ws.directory("/minitest/testdata")
      .withNewFile("project/test/test_other.rb", "require \"minitest/autorun\"\n\nclass OtherTest < Minitest::Test\n  def test_other\n    assert true\n  end\nend\n")
      .asWorkspace
    let host = otlpReceiver("minitest-collection")
    let tool = minitest(root: "project", base: redirect(host + "/v1/traces"))
    let files = tool.tests(source)
    assert(files.keys == ["test/test_other.rb", "test/adder_test.rb"], "unexpected test files: " + files.keys.join(", "))
    tool.test(source, selection: files.subset(keys: ["test/test_other.rb"]))
    tool.test(source, selection: files.subset(keys: []))
    tool.test(source)
    assertSpans(host, [
      "minitest success", "OtherTest#test_other pass",
      "minitest success", "AdderTest#test_add pass", "OtherTest#test_other pass",
    ])
    null
  }

  """
  Rails test files, without system tests, are the collection's keys.
  Selecting one runs only its tests, selecting none runs nothing, and no
  selection runs every file.
  """
  railsCollectionCheck(ws: Workspace!): Void @check {
    let source = ws.directory("/rails/testdata")
      .withNewFile("project/test/models/other_test.rb", "require \"test_helper\"\n\nclass OtherTest < ActiveSupport::TestCase\n  test \"runs\" do\n    assert true\n  end\nend\n")
      .withNewFile("project/test/system/browse_test.rb", "raise \"system tests do not run\"\n")
      .asWorkspace
    let host = otlpReceiver("rails-collection")
    let tool = rails(root: "project", base: redirect(host + "/v1/traces"))
    let files = tool.tests(source)
    assert(
      files.keys == ["test/models/greeting_test.rb", "test/models/other_test.rb"],
      "unexpected test files: " + files.keys.join(", "),
    )
    tool.test(source, selection: files.subset(keys: ["test/models/other_test.rb"]))
    tool.test(source, selection: files.subset(keys: []))
    tool.test(source)
    assertSpans(host, [
      "rails success", "OtherTest#test_runs pass",
      "rails success", "GreetingTest#test_greets_a_saved_name pass", "OtherTest#test_runs pass",
    ])
    null
  }

  """
  Spec files under spec/ are the collection's keys. Selecting one runs only
  its examples, selecting none runs nothing, and no selection runs every file.
  """
  rspecCollectionCheck(ws: Workspace!): Void @check {
    let source = ws.directory("/rspec/testdata")
      .withNewFile("project/spec/other_spec.rb", "RSpec.describe \"other\" do\n  it \"runs\" do\n    expect(true).to be(true)\n  end\nend\n")
      .asWorkspace
    let host = otlpReceiver("rspec-collection")
    let tool = rspec(root: "project", base: redirect(host + "/v1/traces"))
    let files = tool.specs(source)
    assert(files.keys == ["spec/adder_spec.rb", "spec/other_spec.rb"], "unexpected spec files: " + files.keys.join(", "))
    tool.test(source, selection: files.subset(keys: ["spec/other_spec.rb"]))
    tool.test(source, selection: files.subset(keys: []))
    tool.test(source)
    assertSpans(host, [
      "rspec success", "other runs pass",
      "rspec success", "Adder adds two numbers pass", "other runs pass",
    ])
    null
  }

  """
  A clean locked project passes with its own .rubocop.yml and a path gem's
  inherited style.
  """
  lintPassCheck(ws: Workspace!): Void @check {
    let source = testdata(ws).asWorkspace
    let result = failureOf(rubocop(root: "project").lint(source))
    assert(result == "passed", "clean project failed: " + result)
    let cops = ruby(root: "project")
      .container(source)
      .withExec(["bundle", "exec", "rubocop", "--show-cops", "Style/StringLiterals,Style/FrozenStringLiteralComment"])
      .stdout
    assert(cops.contains("EnforcedStyle: double_quotes"), "path gem configuration was not inherited: " + cops)
    assert(cops.contains("Enabled: false"), "project .rubocop.yml was not used: " + cops)
    null
  }

  """
  Offenses fail with RuboCop's output.
  """
  lintFailureCheck(ws: Workspace!): Void @check {
    let source = testdata(ws).withNewFile("project/lib/bad.rb", "# Bad.\nmodule Bad\n  NAME = 'single'\nend\n")
    let offense = failureOf(rubocop(root: "project").lint(source.asWorkspace))
    assert(offense.contains("Style/StringLiterals"), "offense did not fail with RuboCop output: " + offense)
    null
  }
}
