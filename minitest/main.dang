pub description = "Run a locked Ruby project's Minitest suite through its Rakefile"

"""
Minitest for one Bundler project, run as `bundle exec rake test` with the gems
its Gemfile.lock pins.
"""
type Minitest {
  """
  Project root. See the `ruby` module.
  """
  root: String! = "."

  """
  Custom Ruby container. See the `ruby` module.
  """
  base: Container

  """
  Run `bundle exec rake test` in the project root and fail with its output.
  """
  test(ws: Workspace!): Void @check {
    let env = ruby(root: root, base: base)
    let ran = env.container(ws).withExec(["bundle", "exec", "rake", "test"], expect: ANY)
    if (ran.exitCode != 0) {
      raise "Minitest failed in " + env.path + ":\n" + ran.stdout + ran.stderr
    }
    null
  }
}
