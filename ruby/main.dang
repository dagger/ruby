pub description = "A locked Bundler environment shared by the Ruby tool modules"

"""
One Bundler project with its locked gems installed, including development and
test groups, as the Ruby tool modules run it.
"""
type Ruby {
  """
  Project root holding Gemfile and Gemfile.lock, relative to the workspace root.
  """
  root: String! = "."

  """
  Custom container with Ruby and Bundler. Defaults to the official ruby:4.0 image.
  """
  base: Container

  """
  The validated, normalized project root.
  """
  path: String! {
    if (root.hasPrefix("/") or root.split("/").contains("..")) {
      raise "root must be workspace-relative, without '..': " + root
    }
    let normalized = root.split("/").reject { part => part == "" or part == "." }.join("/")
    if (normalized == "") { "." } else { normalized }
  }

  let bundler(ws: Workspace!, frozen: Boolean!): Container! {
    # The whole workspace, not only the root, so path gems and configuration
    # inherited from outside the project resolve as they do locally.
    let source = ws.directory("/", exclude: [".git"], gitignore: true)
    let project = source.directory(path)
    if (project.exists("Gemfile") == false) {
      raise "no Gemfile in " + path + ": set root to the directory holding the Gemfile"
    }
    if (frozen and project.exists("Gemfile.lock") == false) {
      raise "no Gemfile.lock in " + path + ": run `bundle lock` there and commit Gemfile.lock"
    }
    (base ?? Dagger.container.from("ruby:4.0@sha256:342dd3092e25f9d16fc2a5c48c5bb2d9a93717d4f900d005d6e088e2c45d3d19"))
      # A project's .bundle/config outranks the environment, so point Bundler at
      # an empty app config: production settings must not drop the development
      # and test groups tools live in, nor change whether the lockfile is frozen.
      .withEnvVariable("BUNDLE_APP_CONFIG", "/dagger-ruby/bundle-config")
      .withEnvVariable("BUNDLE_FROZEN", if (frozen) { "true" } else { "false" })
      .withEnvVariable("BUNDLE_WITHOUT", "")
      .withDirectory("/src", source)
      .withWorkdir("/src/" + path)
  }

  """
  The workspace at /src with the project's locked gems installed and the
  project root as working directory.
  """
  container(ws: Workspace!): Container! {
    let installed = bundler(ws, frozen: true).withExec(["bundle", "install"], expect: ANY)
    if (installed.exitCode != 0) {
      raise "bundle install failed in " + path + ":\n" + installed.stdout + installed.stderr
    }
    installed
  }

  """
  The workspace at /src with Bundler configured but no gems installed and
  Gemfile.lock writable, for commands that change the lockfile.
  """
  lockfileContainer(ws: Workspace!): Container! {
    bundler(ws, frozen: false)
  }

  """
  Paths of the files under the project root that match any of globs and none
  of exclude, relative to the root.
  """
  files(ws: Workspace!, globs: [String!]!, exclude: [String!]! = []): [String!]! {
    let dir = ws.directory("/" + path, include: globs, exclude: exclude)
    let empty: [String!]! = []
    globs.reduce(empty) { all, glob => all + dir.glob(glob) }.uniq
  }

  """
  ctr with the bundled OpenTelemetry exporter loaded through RUBYOPT, so a
  Minitest or, for suite "rspec", an RSpec run sends a session span named
  suite and one span per test to the trace Dagger provides. An export failure
  only warns.
  """
  let withTestTracing(ctr: Container!, suite: String!): Container! {
    # Added after the bundle is installed and loaded through RUBYOPT, so the
    # project's Gemfile and lock are never touched.
    let traced = ctr
      .withDirectory("/opt/dagger_test_otel", currentModule.source.directory("dagger_test_otel"))
      .withEnvVariable("RUBYOPT", "${RUBYOPT} -I/opt/dagger_test_otel", expand: true)
      .withEnvVariable("DAGGER_TEST_SUITE", suite)
    if (suite == "rspec") {
      # SPEC_OPTS formats replace those of .rspec, so progress keeps a console
      # format alongside the exporter.
      traced.withEnvVariable(
        "SPEC_OPTS",
        "${SPEC_OPTS} --require dagger_rspec_otel --format DaggerRspecOtel --format progress",
        expand: true,
      )
    } else {
      # bundle exec loads Ruby executables in-process, after RUBYOPT has run,
      # and the plugin acts only on a bundle that is already set up; a real
      # exec sets it up first.
      traced
        .withEnvVariable("BUNDLE_DISABLE_EXEC_LOAD", "true")
        .withEnvVariable("RUBYOPT", "${RUBYOPT} -rdagger_minitest_otel", expand: true)
    }
  }

  """
  Run a tool's command in the project root and fail with its output. Files,
  when given, follow the command; an empty list runs nothing. With suite, the
  run sends a session span named suite and one span per test to the trace
  Dagger provides.
  """
  run(ws: Workspace!, tool: String!, command: [String!]!, files: [String!], suite: String): Void {
    if (files == []) {
      null
    } else {
      let ctr = if (suite == null) { container(ws) } else { withTestTracing(container(ws), suite: suite!) }
      let ran = ctr.withExec(command + (files ?? []), expect: ANY)
      if (ran.exitCode != 0) {
        raise tool + " failed in " + path + ":\n" + ran.stdout + ran.stderr
      }
      null
    }
  }
}
